# ZumrutAutomation Platform - Environment Variables
# Copy this file to .env and fill in all required secrets before first start.

# -------------------------------
# CRITICAL SECURITY VARIABLES
# -------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CRYPT_ROUNDS=12

# -------------------------------
# PostgreSQL Database
# -------------------------------
DATABASE_URL=
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=redteam_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_NAME=redteam_automation

# Set to true for fresh installs to auto-create tables.
# Change to false after first production deployment.
TYPEORM_SYNCHRONIZE=true

# -------------------------------
# Default Admin Account
# -------------------------------
DEFAULT_ADMIN_EMAIL=admin@zumrutautomation.local
DEFAULT_ADMIN_PASSWORD=

# -------------------------------
# Runtime Settings
# -------------------------------
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=http://localhost
VITE_API_URL=http://localhost:3001
